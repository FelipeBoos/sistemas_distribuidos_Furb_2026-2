{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-socketchat",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SocketChat/SocketChat.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-chatdistribuido",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/TP01-ChatDistribuido/TP01-ChatDistribuido.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-chatdistribuido-tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/TP01-ChatDistribuido.Tests/ChatDistribuido.Tests.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-all",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/sistemas_distribuidos_Furb_2026-2.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-chatdistribuido",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/TP01-ChatDistribuido.Tests/ChatDistribuido.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
