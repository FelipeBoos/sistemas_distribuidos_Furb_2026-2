# Copie este arquivo para ".env" (nao versionado) na raiz de TP02-IngressosRabbitMQ/ antes de
# rodar qualquer servico. Nenhum destes valores e usado em producao - sao apenas credenciais de
# ambiente de demonstracao.

# ============================================================================
# Caminho atual: RabbitMQ e Postgres em nuvem (CloudAMQP + Neon)
# ============================================================================
# Ver docs/guia-apresentacao.md para o porque dessa escolha (Docker foi avaliado e descartado).

# URI completa do CloudAMQP (Details da instancia -> "AMQP URL"), formato:
# amqps://usuario:senha@host.rmq2.cloudamqp.com/vhost
RABBITMQ_URL=

# Connection string completa do Neon (Dashboard -> Connect -> formato "psql"/".NET"), com
# sslmode=require incluso. Ex.: Host=ep-xxx.sa-east-1.aws.neon.tech;Database=neondb;Username=...;Password=...;Ssl Mode=Require
# Nao adicione "Trust Server Certificate=true": ele desliga a validacao do certificado do servidor
# (risco de MITM). Use-o so em ambiente de teste local, nunca no .env compartilhado.
POSTGRES_CONNECTION_STRING=

# Credenciais SMTP do Mailtrap (Sandbox -> Integration -> SMTP). Host costuma ser
# sandbox.smtp.mailtrap.io, porta 2525.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# false desabilita o Single Active Consumer do Alocador - usado na demonstracao comparativa
# (ver docs/topicos-3-4-5.md, Topico 4).
ALOCADOR_SINGLE_ACTIVE_CONSUMER=true

# Taxas usadas para simular recusa de pagamento e risco de fraude nesta demonstracao.
SERVICOPAGAMENTO_TAXA_RECUSA=0.3
ANTIFRAUDE_TAXA_RISCO_ALTO=0.05

# ============================================================================
# Caminho descartado: RabbitMQ (cluster de 3 nos) e Postgres via Docker Compose
# ============================================================================
# So usado se RABBITMQ_URL/POSTGRES_CONNECTION_STRING acima estiverem vazios. Mantido como
# referencia - ver docker-compose.yml e docs/guia-apresentacao.md.

# RABBITMQ_ERLANG_COOKIE=ingressos-cluster-cookie-troque-isto
# RABBITMQ_USER=ingressos
# RABBITMQ_PASSWORD=ingressos
# RABBITMQ_VHOST=/ingressos
# POSTGRES_DB=ingressos
# POSTGRES_USER=ingressos
# POSTGRES_PASSWORD=ingressos
